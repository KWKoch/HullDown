; Engine configuration file for Hull Down (Godot 4.x)
config_version=5

[application]
config/name="Hull Down"
config/description="WWII naval combat. Squatch Squad Studios."
run/main_scene="res://scenes/testbed.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]
Roster="*res://scripts/data/roster.gd"
Battlegrounds="*res://scripts/data/battlegrounds.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

